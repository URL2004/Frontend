{
  "name": "avoid-professor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "prebuild": "npm test",
    "build": "node scripts/build-vite-static.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test --config=playwright.config.mjs",
    "capture:ui": "node scripts/capture-ui-comparison.mjs",
    "measure:ui": "node scripts/measure-ui-performance.mjs",
    "ga4:auth": "node scripts/ga4-cli.mjs auth",
    "ga4:list": "node scripts/ga4-cli.mjs list",
    "ga4:setup": "node scripts/ga4-cli.mjs setup",
    "ga4:mp-secret": "node scripts/ga4-cli.mjs mp-secret",
    "ga4:validate": "node scripts/ga4-cli.mjs validate",
    "ga4:test": "node scripts/ga4-cli.mjs send-test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "deploy:preview": "vercel deploy --scope toavoidtheprofessor"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1",
    "vite": "^7.3.6"
  }
}
