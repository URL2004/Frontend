      "css": ".ds-btn-share{display:inline-flex;align-items:center;gap:7px;padding:8px 14px;border-radius:999px;cursor:pointer;border:1px solid #d9d2fa;background:#fff;color:#4b34cc;font-size:12.5px;font-weight:800;transition:background .15s ease,border-color .15s ease;font-family:Pretendard,sans-serif}.ds-btn-share svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}.ds-btn-share:hover{background:#f3f0ff;border-color:#c4b8f7}.ds-btn-share:focus-visible{outline:2px solid #4b34cc;outline-offset:3px}"
